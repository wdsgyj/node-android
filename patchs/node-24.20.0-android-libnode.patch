+
+#include "node.h"
+
+#if defined(_WIN32)
+#include <direct.h>
+#define NODE_ANDROID_CHDIR _chdir
+#elif defined(__ANDROID__)
+#include <android/log.h>
+#include <unistd.h>
+#define NODE_ANDROID_CHDIR chdir
+#else
+#include <unistd.h>
+#define NODE_ANDROID_CHDIR chdir
+#endif
+
+namespace {
+
+#if defined(__ANDROID__)
+
+constexpr size_t kAndroidLogChunkSize = 4000;
+
+void WriteAndroidLogChunks(int priority,
+                           const std::string& tag,
+                           const char* data,
+                           size_t length) {
+  while (length > 0) {
+    const size_t chunk_length = std::min(length, kAndroidLogChunkSize);
+    std::string chunk(data, chunk_length);
+    while (!chunk.empty() && (chunk.back() == '\n' || chunk.back() == '\r')) {
+      chunk.pop_back();
+    }
+    if (!chunk.empty()) {
+      __android_log_write(priority, tag.c_str(), chunk.c_str());
+    }
+    data += chunk_length;
+    length -= chunk_length;
+  }
+}
+
+void DrainAndroidLogPipe(int fd, int priority, std::string tag) {
+  char buffer[4096];
+  for (;;) {
+    const ssize_t length = read(fd, buffer, sizeof(buffer));
+    if (length == 0) {
+      break;
+    }
+    if (length < 0) {
+      if (errno == EINTR) {
+        continue;
+      }
+      break;
+    }
+    WriteAndroidLogChunks(priority, tag, buffer, length);
+  }
+  close(fd);
+}
+
+class AndroidLogRedirect {
+ public:
+  AndroidLogRedirect() = default;
+  AndroidLogRedirect(const AndroidLogRedirect&) = delete;
+  AndroidLogRedirect& operator=(const AndroidLogRedirect&) = delete;
+
+  int Start() {
+    const char* requested_tag = getenv("NODE_ANDROID_LOG_TAG");
+    tag_ = requested_tag != nullptr && requested_tag[0] != '\0'
+               ? requested_tag
+               : "nodejs";
+
+    if (pipe(stdout_pipe_) != 0 || pipe(stderr_pipe_) != 0) {
+      ClosePipes();
+      return -1;
+    }
+
+    saved_stdout_ = dup(STDOUT_FILENO);
+    saved_stderr_ = dup(STDERR_FILENO);
+    if (saved_stdout_ < 0 || saved_stderr_ < 0 ||
+        dup2(stdout_pipe_[1], STDOUT_FILENO) < 0 ||
+        dup2(stderr_pipe_[1], STDERR_FILENO) < 0) {
+      Restore();
+      return -1;
+    }
+
+    stdout_thread_ =
+        std::thread(DrainAndroidLogPipe, stdout_pipe_[0], ANDROID_LOG_INFO,
+                    tag_);
+    stderr_thread_ =
+        std::thread(DrainAndroidLogPipe, stderr_pipe_[0], ANDROID_LOG_ERROR,
+                    tag_);
+    stdout_pipe_[0] = -1;
+    stderr_pipe_[0] = -1;
+    return 0;
+  }
+
+  ~AndroidLogRedirect() {
+    Restore();
+  }
+
+ private:
+  void ClosePipes() {
+    for (int& fd : stdout_pipe_) {
+      if (fd >= 0) {
+        close(fd);
+        fd = -1;
+      }
+    }
+    for (int& fd : stderr_pipe_) {
+      if (fd >= 0) {
+        close(fd);
+        fd = -1;
+      }
+    }
+  }
+
+  void Restore() {
+    if (saved_stdout_ >= 0) {
+      fflush(stdout);
+      dup2(saved_stdout_, STDOUT_FILENO);
+      close(saved_stdout_);
+      saved_stdout_ = -1;
+    }
+    if (saved_stderr_ >= 0) {
+      fflush(stderr);
+      dup2(saved_stderr_, STDERR_FILENO);
+      close(saved_stderr_);
+      saved_stderr_ = -1;
+    }
+
+    ClosePipes();
+    if (stdout_thread_.joinable()) {
+      stdout_thread_.join();
+    }
+    if (stderr_thread_.joinable()) {
+      stderr_thread_.join();
+    }
+  }
+
+  int stdout_pipe_[2]{-1, -1};
+  int stderr_pipe_[2]{-1, -1};
+  int saved_stdout_ = -1;
+  int saved_stderr_ = -1;
+  std::string tag_;
+  std::thread stdout_thread_;
+  std::thread stderr_thread_;
+};
+
+#endif  // defined(__ANDROID__)
+
+int SetEnvironmentAssignment(const char* assignment) {
+  if (assignment == nullptr) {
+    errno = EINVAL;
+    return -1;
+  }
+
+  const char* separator = strchr(assignment, '=');
+  if (separator == nullptr || separator == assignment) {
+    errno = EINVAL;
+    return -1;
+  }
+
+  std::string name(assignment, separator - assignment);
+  const char* value = separator + 1;
+#if defined(_WIN32)
+  return _putenv_s(name.c_str(), value);
+#else
+  return setenv(name.c_str(), value, 1);
+#endif
+}
+
+int SetEnvironmentVariable(const char* name, const char* value) {
+  if (value == nullptr) {
+    return 0;
+  }
+
+  std::string assignment(name);
+  assignment.push_back('=');
+  assignment.append(value);
+  return SetEnvironmentAssignment(assignment.c_str());
+}
+
+}  // namespace
+
+extern "C" int node_android_run(int argc,
+                                const char* const* argv,
+                                const char* cwd,
+                                const char* home,
+                                const char* tmpdir,
+                                const char* module_path,
+                                const char* const* envp) {
+  if (argc <= 0 || argv == nullptr) {
+    errno = EINVAL;
+    return -1;
+  }
+
+  for (int i = 0; i < argc; ++i) {
+    if (argv[i] == nullptr) {
+      errno = EINVAL;
+      return -1;
+    }
+  }
+
+  if (envp != nullptr) {
+    for (const char* const* current = envp; *current != nullptr; ++current) {
+      if (SetEnvironmentAssignment(*current) != 0) {
+        return -1;
+      }
+    }
+  }
+
+  if (SetEnvironmentVariable("HOME", home) != 0 ||
+      SetEnvironmentVariable("TMPDIR", tmpdir) != 0 ||
+      SetEnvironmentVariable("NODE_PATH", module_path) != 0) {
+    return -1;
+  }
+
+  if (cwd != nullptr && NODE_ANDROID_CHDIR(cwd) != 0) {
+    return -1;
+  }
+
+#if defined(__ANDROID__)
+  fflush(stdout);
+  fflush(stderr);
+  AndroidLogRedirect log_redirect;
+  if (log_redirect.Start() != 0) {
+    return -1;
+  }
+#endif
+
+  std::vector<std::vector<char>> argument_storage(argc);
+  std::vector<char*> mutable_argv(argc);
+  for (int i = 0; i < argc; ++i) {
+    const size_t length = strlen(argv[i]);
+    argument_storage[i].assign(argv[i], argv[i] + length);
+    argument_storage[i].push_back('\0');
+    mutable_argv[i] = argument_storage[i].data();
+  }
+
+  return node::Start(argc, mutable_argv.data());
+}
