+#!/bin/sh
+set -eu
+
+output=${1:?output version script is required}
+
+{
+  printf '%s\n' '{' '  global:'
+  printf '%s\n' \
+    '    node_android_run;' \
+    '    node_module_register;' \
+    '    napi_*;' \
+    '    node_api_*;'
+  printf '%s\n' '  local: *;' '};'
+} > "$output"
+
+grep -q '^    node_android_run;$' "$output"
+grep -q '^    node_module_register;$' "$output"
