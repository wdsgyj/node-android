+#ifndef SRC_NODE_ANDROID_H_
+#define SRC_NODE_ANDROID_H_
+
+#include <stddef.h>
+
+#if defined(_WIN32)
+#define NODE_ANDROID_API __declspec(dllexport)
+#else
+#define NODE_ANDROID_API __attribute__((visibility("default")))
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * Starts Node.js using a main()-style argument vector.
+ *
+ * argv must contain argc non-null strings and should normally include the
+ * executable name at argv[0]. envp is an optional null-terminated list of
+ * KEY=VALUE strings. Explicit directory arguments override values supplied
+ * through envp. The environment and working directory changes are process
+ * wide and remain in effect after this function returns.
+ *
+ * Returns the Node.js exit code, or -1 if the arguments or process setup are
+ * invalid. errno identifies the setup failure in the latter case.
+ *
+ * On Android, stdout is written to logcat with INFO priority and stderr with
+ * ERROR priority while Node.js is running. The logcat tag defaults to
+ * "nodejs" and can be overridden with NODE_ANDROID_LOG_TAG.
+ */
+NODE_ANDROID_API int node_android_run(
+    int argc,
+    const char* const* argv,
+    const char* cwd,
+    const char* home,
+    const char* tmpdir,
+    const char* module_path,
+    const char* const* envp);
+
+#ifdef __cplusplus
+}  // extern "C"
+#endif
+
+#endif  // SRC_NODE_ANDROID_H_
